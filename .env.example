# --- Bağımsız API modu (start.sh bu değerleri okur) ---
# Host üzerinde yayınlanacak adres/port. Servis kimlik doğrulaması yapmaz;
# dışarıya açmak istemiyorsanız 127.0.0.1 bırakın.
BIND_ADDRESS=127.0.0.1
API_PORT=8000

# --- OPSİYONEL: RabbitMQ consumer (docker-compose.rabbitmq.yml ile kullanılır) ---
# Bağımsız API kullanımında bu değerlere ihtiyaç yoktur.
RABBITMQ_HEARTBEAT_SECONDS=600
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_QUEUE_FILE=file_processing_queue
RABBITMQ_EXCHANGE_FILE=file_processing_exchange
RABBITMQ_ROUTING_KEY_FILE=file_processing_routing_key
BACKEND_CALLBACK_URL=http://rag-platform-backend:8080/uctma/api/file/callback
CALLBACK_SHARED_SECRET=GENERATED_BY_START_SH
